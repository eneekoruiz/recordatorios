# Recordatorios Élite — variables de entorno
# Copia este archivo a `.env` (local) o configúralas en Vercel → Settings → Environment Variables.

# ── Base de datos (obligatoria para sincronizar) ─────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Sesiones (OBLIGATORIA en producción) ─────────────────────────────────────
# Cadena aleatoria de 32+ caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si falta en producción, el servidor deshabilita el login en lugar de usar un secreto conocido.
JWT_SECRET=""

# URL pública de la app (se usa en los enlaces de recuperación de contraseña)
APP_URL="https://tu-app.vercel.app"

# ── Recuperación de contraseña por email (opcional, recomendado) ─────────────
# Crea una cuenta gratuita en https://resend.com, verifica tu dominio y pega la API key.
# Sin estas dos variables, "¿Has olvidado tu contraseña?" responde que no está disponible.
RESEND_API_KEY=""
MAIL_FROM="Recordatorios <no-reply@tu-dominio.com>"

# ── CORS (opcional) ──────────────────────────────────────────────────────────
# Orígenes extra autorizados en producción, separados por comas (la propia app no lo necesita).
ALLOWED_ORIGINS=""

# ── Avisos con la app cerrada (Web Push) ─────────────────────────────────────
# Genera las claves una vez con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@tu-dominio.com"
# Protege /api/cron/notify. Vercel Cron lo envía solo si está definida.
CRON_SECRET=""
