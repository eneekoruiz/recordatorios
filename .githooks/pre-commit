#!/bin/sh
# Pre-commit hook: Escaneo obligatorio de secretos en staged files

SCANNER_CMD="secret-scanner"
if ! command -v secret-scanner >/dev/null 2>&1; then
    if [ -f "$HOME/.gemini/antigravity/bin/secret-scanner.cjs" ]; then
        SCANNER_CMD="node $HOME/.gemini/antigravity/bin/secret-scanner.cjs"
    elif [ -f "C:/Users/User/.gemini/antigravity/bin/secret-scanner.cjs" ]; then
        SCANNER_CMD="node C:/Users/User/.gemini/antigravity/bin/secret-scanner.cjs"
    fi
fi

$SCANNER_CMD --staged
STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [ERROR CRÍTICO] Se detectaron secretos o credenciales en los archivos staged."
    echo "🚫 COMMIT ABORTADO INMEDIATAMENTE POR SEGURIDAD."
    echo ""
    exit 1
fi

exit 0
