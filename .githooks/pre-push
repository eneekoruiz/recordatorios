#!/bin/sh
# Pre-push hook optimizado y paralelizado para git push ultrarrápido

if [ "$FAST_PUSH" = "1" ] || [ "$SKIP_HOOKS" = "1" ]; then
    echo "⚡ [Git Pre-Push Hook] Verificación omitida (FAST_PUSH=1)."
    exit 0
fi

echo "🛡️  [Git Pre-Push Hook] Verificando calidad en paralelo..."

# 1. Prisma Client: solo si el schema cambió frente a origin/main o si falta el cliente
if git diff --name-only origin/main...HEAD 2>/dev/null | grep -q "prisma/schema.prisma" || [ ! -d "node_modules/@prisma/client" ]; then
    echo "📦 [1/3] Actualizando cliente de Prisma..."
    npx prisma generate || exit 1
fi

# 2. Typecheck y Linter en paralelo (máxima velocidad ~4s)
echo "🔍 [2/3] TypeScript (tsc -b) y Linter (oxlint) en paralelo..."
npx concurrently --kill-others-on-fail -n "types,lint" "npm run typecheck" "npm run lint"
STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [ERROR] Falló la comprobación estática (TypeScript o Linter)."
    echo "🚫 PUSH ABORTADO."
    exit 1
fi

# 3. Tests unitarios: solo de los archivos afectados por los cambios a subir
echo "🧪 [3/3] Tests de módulos modificados..."
npx vitest run --changed origin/main --passWithNoTests
STATUS=$?
if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [ERROR] Fallaron los tests de los archivos modificados."
    echo "🚫 PUSH ABORTADO."
    exit 1
fi

echo "✅ [Git Pre-Push Hook] Validación paralela completada con éxito."
exit 0
